# ─────────────────────────────────────────────────────
# Vyral — Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────────────

# ── APP ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vyral

# ── DATABASE (Supabase / Neon / Railway PostgreSQL) ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vyral?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/vyral"

# ── NEXTAUTH ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ── GOOGLE OAuth (for login) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── ANTHROPIC (AI content generation) ───────────────
ANTHROPIC_API_KEY=

# ── REDIS (BullMQ job queue — Upstash / Railway) ────
REDIS_URL="redis://localhost:6379"
# For Upstash:
# REDIS_URL="rediss://default:TOKEN@HOST.upstash.io:6379"

# ── SOCIAL PLATFORM APIs ─────────────────────────────

## Instagram / Facebook (Meta Graph API)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=vyral_webhook_secret

## Twitter / X (v2 OAuth 2.0 PKCE)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

## LinkedIn (OAuth 2.0)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

## YouTube (Google OAuth — separate app recommended)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

## WhatsApp Business API (via Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── PAYMENTS (Razorpay) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=  # same as RAZORPAY_KEY_ID

# ── ADMIN ─────────────────────────────────────────────
# Comma-separated emails allowed to view /admin (the business dashboard —
# revenue, plan breakdown, signups). Required — the app throws if unset.
ADMIN_EMAILS=admin@example.com

# ── EMAIL (Resend) ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@vyral.in

# ── FILE UPLOADS (Cloudflare R2 / AWS S3) ────────────
S3_REGION=auto
S3_BUCKET=vyral-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=  # Cloudflare R2 endpoint
NEXT_PUBLIC_CDN_URL=  # your public CDN URL
